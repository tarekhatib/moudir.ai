# Used by docker-compose.yml. Copy to .env and fill in.

# Public hostname; Caddy fetches an HTTPS certificate for it automatically.
# Point the domain's DNS at this server first. Use "localhost" to try it locally.
DOMAIN=moudir.example.com

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Set to false once your customers' accounts exist, if sign-up should be invite-only.
ALLOW_SIGNUP=true

# development | production. Production hides /docs and sends Secure cookies.
ENVIRONMENT=development

# SQLite for local development; Postgres in production, e.g.
# DATABASE_URL=postgresql://moudir:password@localhost:5432/moudir
DATABASE_URL=sqlite:///./data/moudir.db

# Origins allowed to call the API from another origin. The Vite dev server proxies /api,
# so this is only needed if you point the dashboard straight at the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to false to stop new organizations signing up.
ALLOW_SIGNUP=true
